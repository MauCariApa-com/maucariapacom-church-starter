---
import { formatDate } from '../../utils/dateUtils';
import Button from '../UI/Button.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  sermon: CollectionEntry<'sermons'>;
  className?: string;
  ctaText?: string;
  imageSrc?: string;
  showScripture?: boolean;
}

const {
  sermon,
  className = '',
  ctaText = 'Listen / Watch',
  imageSrc = sermon.data.image || '/uploads/sermon-placeholder.webp',
  showScripture = true,
} = Astro.props;
const href = `/sermons/${sermon.id}`;
---

<div class:list={['card group overflow-hidden flex flex-col h-full', className]}>
  <a href={href} class="overflow-hidden aspect-video block">
    <img
      src={imageSrc}
      alt={sermon.data.title}
      class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
    />
  </a>

  <div class="p-5 flex flex-col flex-1">
    <a href={href} class="block">
      <h3 class="mb-2 text-xl font-bold group-hover:text-primary-600 transition-colors">{sermon.data.title}</h3>
    </a>

    <div class="text-gray-700 flex flex-col flex-1">
      <div class="mb-3 flex items-center text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>{formatDate(sermon.data.date)}</span>
      </div>

      <div class="mb-3 flex items-center text-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>{sermon.data.speaker}</span>
      </div>

      {
        sermon.data.series && (
          <div class="mb-3 flex items-center text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span>Series: {sermon.data.series}</span>
          </div>
        )
      }

      {
        showScripture && sermon.data.scripture && (
          <div class="mb-3 flex items-center text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <span>{sermon.data.scripture}</span>
          </div>
        )
      }

      <p class="text-gray-700 mb-4 line-clamp-3">{sermon.data.summary}</p>

      <div class="mt-auto">
        <Button href={href} variant="primary" size="sm">
          {ctaText}
        </Button>
      </div>
    </div>
  </div>
</div>
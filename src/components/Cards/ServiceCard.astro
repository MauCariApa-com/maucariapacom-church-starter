---
export interface Props {
  title: string;
  bgClass?: string;
  className?: string;
}

const {
  title,
  bgClass = 'bg-gray-50',
  className = '',
} = Astro.props;
---

<div class:list={['p-8 rounded-lg shadow-sm', bgClass, className]}>
  <h3 class="text-xl font-bold mb-3">{title}</h3>
  <slot />
</div>

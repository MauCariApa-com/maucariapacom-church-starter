---
import Button from "../UI/Button.astro";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/dateUtils";

export interface Props {
  sermon: CollectionEntry<"sermons">;
}

const { sermon } = Astro.props;
const formattedDate = formatDate(sermon.data.date);
---

<div class="bg-gray-50 p-6 rounded-lg shadow-sm sticky top-24">
  <h3 class="font-bold mb-4">Sermon Information</h3>

  <div class="space-y-4 mb-6">
    <div>
      <h4 class="font-bold text-gray-700 mb-1">Speaker</h4>
      <p>{sermon.data.speaker}</p>
    </div>

    {
      sermon.data.series && (
        <div>
          <h4 class="font-bold text-gray-700 mb-1">Series</h4>
          <p>{sermon.data.series}</p>
        </div>
      )
    }

    <div>
      <h4 class="font-bold text-gray-700 mb-1">Date</h4>
      <p>{formattedDate}</p>
    </div>

    {
      sermon.data.scripture && (
        <div>
          <h4 class="font-bold text-gray-700 mb-1">Scripture</h4>
          <p>{sermon.data.scripture}</p>
        </div>
      )
    }

    {
      sermon.data.tags && sermon.data.tags.length > 0 && (
        <div>
          <h4 class="font-bold text-gray-700 mb-2">Tags</h4>
          <div class="flex flex-wrap gap-2">
            {sermon.data.tags.map((tag) => (
              <span class="px-2 py-1 text-xs font-medium text-primary-700 bg-primary-100 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>

  <div class="flex flex-col space-y-3">
    <Button href="/sermons" variant="outline"> Back to All Sermons </Button>

    <Button href="/contact?subject=Sermon+Question" variant="outline">
      Have a Question?
    </Button>
  </div>
</div>

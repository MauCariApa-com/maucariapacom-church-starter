---
export interface Props {
  title: string;
  description: string;
  href?: string;
  ctaText?: string;
  iconBgClass?: string;
  className?: string;
}

const {
  title,
  description,
  href,
  ctaText = 'Learn More',
  iconBgClass = 'bg-primary-100',
  className = 'p-8',
} = Astro.props;
---

<div class:list={['bg-white rounded-lg shadow-md text-center', className]}>
  <div class:list={['w-20 h-20 mx-auto mb-4 rounded-full flex items-center justify-center', iconBgClass]}>
    <slot name="icon" />
  </div>
  <h3 class="text-xl font-bold mb-3">{title}</h3>
  <p class="text-gray-700 mb-4">{description}</p>
  {
    href && (
      <a href={href} class="text-primary-600 font-medium hover:text-primary-700">
        {ctaText} →
      </a>
    )
  }
</div>

---
export interface Props {
  title: string;
  description: string;
  iconBgClass?: string;
  className?: string;
}

const {
  title,
  description,
  iconBgClass = 'bg-primary-100',
  className = '',
} = Astro.props;
---

<div class:list={['bg-white p-8 rounded-lg shadow-sm', className]}>
  <div class:list={['w-16 h-16 rounded-full flex items-center justify-center mb-6', iconBgClass]}>
    <slot name="icon" />
  </div>
  <h3 class="text-xl font-bold mb-3">{title}</h3>
  <p class="text-gray-700">{description}</p>
</div>

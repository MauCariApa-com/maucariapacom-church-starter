---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Sections/HeroSection.astro";
import EventList from "../components/Sections/EventList.astro";
import SermonList from "../components/Sections/SermonList.astro";
import ServiceCard from "../components/Cards/ServiceCard.astro";
import FeatureCard from "../components/Cards/FeatureCard.astro";
import Button from "../components/UI/Button.astro";
---

<BaseLayout>
  <HeroSection 
    title="Welcome to Our Church"
    subtitle="A place of worship, community, and spiritual growth"
    backgroundImage="/uploads/hero-bg.webp"
    ctaText="Plan Your Visit"
    ctaLink="/im-new"
    secondaryCtaText="Watch Sermons"
    secondaryCtaLink="/sermons"
  />
  
  <!-- Service Times -->
  <section class="py-16 bg-white">
    <div class="container">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Join Us This Sunday</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <ServiceCard title="Morning Service">
            <p class="text-2xl font-bold text-primary-600 mb-2">8:00 AM</p>
            <p class="text-gray-600 mb-4">Traditional service with hymns and choir</p>
            <p class="italic text-gray-500">In-person & Livestream</p>
          </ServiceCard>
          
          <ServiceCard title="Family Service">
            <p class="text-2xl font-bold text-primary-600 mb-2">10:30 AM</p>
            <p class="text-gray-600 mb-4">Contemporary worship with children's ministry</p>
            <p class="italic text-gray-500">In-person only</p>
          </ServiceCard>
        </div>
        
        <Button href="/im-new" variant="outline">
          Plan Your Visit
        </Button>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <img 
            src="/uploads/church-default.webp" 
            alt="Our Church" 
            class="rounded-lg shadow-lg object-cover w-full h-full"
          />
        </div>
        
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">About Our Church</h2>
          <p class="text-gray-700 mb-6 text-lg">
            We are a welcoming Christian community dedicated to sharing God's love through worship, fellowship, and service. Our church has been serving the community for over 50 years, providing a place for spiritual growth and connection.
          </p>
          <p class="text-gray-700 mb-8 text-lg">
            Whether you're exploring faith for the first time or looking for a church home, we invite you to join us. Our diverse congregation welcomes people of all ages, backgrounds, and walks of life.
          </p>
          
          <Button href="/about-us">
            Learn More About Us
          </Button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Events Section -->
  <EventList />
  
  <!-- Sermons Section -->
  <SermonList />
  
  <!-- Ministries Preview -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Our Ministries</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Discover how you can connect, serve, and grow through our various ministries
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <FeatureCard
          title="Children's Ministry"
          description="Nurturing the spiritual growth of our children through engaging, age-appropriate activities."
          href="/ministries/childrens-ministry"
          ctaText="Learn More"
          iconBgClass="bg-primary-100"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </FeatureCard>
        
        <FeatureCard
          title="Worship Ministry"
          description="Leading our congregation in worship through music, song, and creative expression."
          href="/ministries/worship-ministry"
          ctaText="Learn More"
          iconBgClass="bg-secondary-100"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-secondary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
          </svg>
        </FeatureCard>
        
        <FeatureCard
          title="Community Outreach"
          description="Serving our local community through various programs and initiatives to share God's love."
          href="/ministries/community-outreach"
          ctaText="Learn More"
          iconBgClass="bg-accent-100"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-accent-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        </FeatureCard>
      </div>
      
      <div class="mt-12 text-center">
        <Button href="/ministries" variant="outline">
          View All Ministries
        </Button>
      </div>
    </div>
  </section>
  
  <!-- Call to Action -->
  <section 
    class="py-20 bg-cover bg-center text-white"
    style="background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url(/uploads/thank-you-bg.webp)"
  >
    <div class="container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-white">Ready to Join Our Community?</h2>
        <p class="text-xl mb-8">
          We'd love to welcome you to our church family. Come visit us this Sunday or reach out with any questions.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <Button href="/im-new" variant="primary" size="lg">
            I'm New Here
          </Button>
          
          <Button href="/contact" variant="outline" size="lg" class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm">
            Contact Us
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>